PORT=3000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/earn-task-platform?replicaSet=rs0
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
# Cloudinary is required in production; development can use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated browser origins (not needed for native Android).
CORS_ORIGINS=http://localhost:8081
MAX_FILE_SIZE=50mb
MAX_VIDEO_SIZE=100mb
# Only needed for npm run create-admin:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Required when NODE_ENV=staging. Also set explicitly when staging uses NODE_ENV=production.
# Staging: CLOUDINARY_FOLDER_PREFIX=earn-task-platform/staging
# Production: CLOUDINARY_FOLDER_PREFIX=earn-task-platform/production
# Development default (when omitted): earn-task-platform

# Existing media remains Cloudinary unless explicitly configured otherwise.
MEDIA_STORAGE_PROVIDER=cloudinary
# Optional category-specific overrides: IMAGES, VIDEOS, REELS, DOCUMENTS
# MEDIA_STORAGE_PROVIDER_VIDEOS=r2
# R2 requires a dedicated private staging/test bucket for direct uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Set true only after checking r2.dev and custom domains are disabled.
R2_PRIVATE_BUCKET=false
# Optional future public/CDN delivery base. Leave empty for private direct uploads.
# Must be empty: the application implements private signed R2 delivery only.
R2_PUBLIC_BASE_URL=
# Live tests additionally require R2_INTEGRATION_TEST=true and
# R2_TEST_BUCKET_CONFIRM equal to a bucket name containing staging or test.
