PORT=3000
HOST=0.0.0.0
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/earn-task-platform?replicaSet=rs0
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRE=1h
JWT_REFRESH_EXPIRE=7d
# Cloudinary is required in production; development can use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated browser origins (not needed for native Android).
CORS_ORIGINS=http://localhost:8081
MAX_FILE_SIZE=50mb
MAX_VIDEO_SIZE=100mb
# Only needed for npm run create-admin:
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
