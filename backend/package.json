{
  "name": "earn-task-platform-backend",
  "version": "1.0.0",
  "description": "Backend API for Earn Task Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:media-safety": "node --test --test-concurrency=1 test/media-reconciliation.test.js test/migration.test.js",
    "seed": "node src/scripts/seedTasks.js",
    "create-admin": "node src/scripts/createAdmin.js",
    "test:cloudinary": "node --test test/integration/cloudinary.test.js",
    "reconcile": "node scripts/reconcile-wallets.js --dry-run",
    "test:smoke": "node scripts/smoke.js",
    "test:load": "node --expose-gc scripts/load-test.js",
    "test:r2": "node --test test/integration/r2.test.js",
    "test:storage-load": "node scripts/storage-load-test.js",
    "media:cleanup": "node scripts/cleanup-media.js",
    "migrate:media": "node scripts/migrate-media.js",
    "test:r2:browser": "R2_BROWSER_TEST=true R2_STAGING_TEST=true node scripts/r2-staging-validation.js",
    "reconcile:media": "node scripts/reconcile-media.js"
  },
  "keywords": [
    "express",
    "api",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.0.1",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20.20 <25"
  }
}
